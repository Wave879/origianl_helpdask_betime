<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="524288000" />
      </requestFiltering>
    </security>
    <serverRuntime uploadReadAheadSize="1048576" />
    <rewrite>
      <rules>
        <rule name="Normalize web prefix" stopProcessing="true">
          <match url="^web$" />
          <action type="Redirect" url="/web/" redirectType="Found" />
        </rule>
        <rule name="Serve web landing page" stopProcessing="true">
          <match url="^web/?$" />
          <action type="Rewrite" url="http://192.168.100.12:19120/web/" logRewrittenUrl="true" />
        </rule>
        <rule name="Proxy web app" stopProcessing="true">
          <match url="^web/(.*)" />
          <action type="Rewrite" url="http://192.168.100.12:19120/web/{R:1}" logRewrittenUrl="true" />
        </rule>
        <rule name="Proxy Betime root files" stopProcessing="true">
          <match url="^(assets/betime_solution/.*|shared\.js|config\.js)$" />
          <action type="Rewrite" url="http://192.168.100.12:19120/{R:1}" logRewrittenUrl="true" />
        </rule>
      </rules>
    </rewrite>
    <proxy reverseRewriteHostInResponseHeaders="false" preserveHostHeader="true" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
