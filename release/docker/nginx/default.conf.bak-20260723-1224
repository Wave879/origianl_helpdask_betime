server {
    listen 80;
    server_name _;
    server_tokens off;
    absolute_redirect off;

    client_max_body_size 500m;

    location = / {
        return 302 /web/;
    }

    location = /web {
        return 301 /web/;
    }

    location ~ ^/web/web/(.*)$ {
        return 301 /web/$1;
    }

    location ~ ^/(.+)\.html$ {
        return 301 /web/$1;
    }

    location ^~ /web/ {
        proxy_pass http://betime-app:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /web;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_redirect ~^/(?!web/)(.*)$ /web/$1;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }

        location = /web/dashboard/index.html {
            return 302 /web/dashboard;
        }

        location = /web/manager-dashboard/index.html {
            return 302 /web/manager-dashboard;
        }

        location = /web/staff-dashboard/index.html {
            return 302 /web/staff-dashboard;
        }

    location ~ ^/(assets/betime_solution/.*|shared\.js|config\.js)$ {
        proxy_pass http://betime-app:8788;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /web;
        proxy_hide_header Server;
        proxy_hide_header X-Powered-By;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
        proxy_redirect off;
    }

    location / {
        return 301 /web$request_uri;
    }
}
